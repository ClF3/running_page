# On violet: /data/tianyi/running-page/config/credentials.env (0600).
# Never commit real values. Prefer an official Garmin Connect Personal API key.
GARMIN_PERSONAL_API_KEY=
# Optional legacy CN session; used only when GARMIN_PERSONAL_API_KEY is empty.
GARMIN_SECRET_STRING_CN=
# Optional international upload session. Prefer ops/global-login --enable;
# that saves a renewable session under state/private without saving passwords.
GARMIN_GLOBAL_SECRET_STRING=
# A session file at /config/garmin-global-session.txt is also accepted.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional GitHub credentials are mounted separately:
# violet: config/github_ed25519 and config/known_hosts under the deployment root.
